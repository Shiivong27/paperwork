{
  "name": "rea-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for evidence-based reverse engineering and tool development",
  "scripts": {
    "start": "npm --prefix tools/image-to-pdf start",
    "build:app": "npm --prefix tools/image-to-pdf run build",
    "build": "npm run build:app",
    "test": "npm --prefix tools/image-to-pdf test",
    "rea": "bash scripts/rea.sh",
    "rea:verify": ".rea/runtime/node_modules/.bin/node scripts/verify-rea.mjs"
  },
  "devDependencies": {
    "rea-agents": "6.8.0"
  }
}
